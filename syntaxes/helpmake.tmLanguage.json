{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "HelpMake",
    "scopeName": "source.helpmake",
    "patterns": [
        { "include": "#comments" },
        { "include": "#config-and-dependency-headers" },
        { "include": "#blocks" },
        { "include": "#variables" },
        { "include": "#fields" },
        { "include": "#values" }
    ],
    "repository": {
        "comments": {
            "patterns": [{
                "name": "comment.line.number-sign.helpmake",
                "match": "#.*$"
            }]
        },
        "config-and-dependency-headers": {
            "patterns": [{
                "match": "\\b(Config|Dependency)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_-]*)\\s*\\{",
                "captures": {
                    "1": { "name": "keyword.control.block.helpmake" },
                    "2": { "name": "entity.name.type.block.helpmake" }
                }
            }]
        },
        "blocks": {
            "patterns": [{
                "name": "keyword.control.block.helpmake",
                "match": "\\b(InputFiles|Includes|Flags|Modules|Fetch|PreBuild|PostBuild|Copy|Set|Arguments)\\b(?=\\s*\\{)"
            }]
        },
        "variables": {
            "patterns": [{
                "name": "variable.other.helpmake",
                "match": "\\[\\[[^\\]]+\\]\\]"
            }]
        },
        "fields": {
            "patterns": [{
                "name": "support.type.property-name.helpmake",
                "match": "\\b(Compiler|Version|Output|Kind|Run|Jobs|PCH|Depends|Arguments|InputFiles|Includes|Flags|Modules|Git|Url|Path|Tag|Commit|Hash|Build|Include|Link|LinkDir|LinkFlags)\\b(?=\\s*:)"
            }]
        },
        "values": {
            "patterns": [{
                "name": "string.unquoted.value.helpmake",
                "match": "(?<=:)(.+)$"
            }]
        }
    }
}