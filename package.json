{
    "name": "helpmake",
    "icon": "icon.png",
    "displayName": "HelpMake",
    "description": "Syntax highlighting for HelpMake.txt",
    "version": "1.0.0",
    "publisher": "Xavi99",
    "engines": { "vscode": "^1.60.0" },
    "categories": ["Programming Languages"],
    "repository": {
    "type": "git",
    
    "url": "https://github.com/Gag91/HelpMake-Vscode-Extension" },
    "contributes": {
        "languages": [{
            "id": "helpmake",
            "aliases": ["HelpMake", "helpmake"],
            "extensions": [".helpmake"],
            "filenames": ["HelpMake.txt"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "helpmake",
            "scopeName": "source.helpmake",
            "path": "./syntaxes/helpmake.tmLanguage.json"
        }]
    }
}