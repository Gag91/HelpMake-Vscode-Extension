{
    "name": "helpmake",
    "icon": "icon.png",
    "displayName": "HelpMake",
    "description": "Syntax highlighting for HelpMake.txt build files",
    "version": "1.1.0",
    "publisher": "Xavi99",
    "engines": { "vscode": "^1.60.0" },
    "categories": ["Programming Languages"],
    "keywords": ["helpmake", "build system", "syntax highlighting", "c++", "zig", "go"],
    "repository": {
        "type": "git",
        "url": "https://github.com/Gag91/HelpMake-Vscode-Extension"
        },
    "contributes": {
        "languages": [{
            "id": "helpmake",
            "aliases": ["HelpMake", "helpmake"],
            "extensions": [".helpmake"],
            "filenames": ["HelpMake.txt"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "helpmake",
            "scopeName": "source.helpmake",
            "path": "./syntaxes/helpmake.tmLanguage.json"
        }]
    }
    
}